{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/nexcrm.db"
  },
  "Jwt": {
    "Issuer": "NexCrmLite",
    "Audience": "NexCrmLite.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 480
  },
  "App": {
    "DemoMode": false,
    "ClientOrigin": "https://crm.example.com"
  },
  "RateLimiting": {
    "LoginPerMinute": 20,
    "RequestsPerMinute": 600,
    "ExportsPerMinute": 10,
    "FailedLoginsPerSource": 5,
    "FailedLoginsPerAccount": 20,
    "LockoutMinutes": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nexcrm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "Network": {
    "KnownProxies": []
  },
  "Diagnostics": {
    "Enabled": false
  },
  "Performance": {
    "MinThreadPoolThreads": 32
  }
}
